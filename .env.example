# QA Framework Environment Configuration
# Copy to .env and customize

# Environment: local, ci, staging, prod
ENV=local

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Browser settings
BROWSER_NAME=chromium
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE_ID=UTC

# API settings
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT=30.0
API_RETRIES=3
API_BACKOFF_FACTOR=0.5

# Database settings (for DB tests)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=testdb

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Test execution settings
TEST_PARALLEL_WORKERS=0
TEST_RERUNS=2
TEST_RERUNS_DELAY=1.0
TEST_SCREENSHOT_ON_FAILURE=true
TEST_VIDEO_ON_FAILURE=false
TEST_TRACE_ON_FAILURE=true
TEST_HTML_REPORT=true
TEST_ALLURE_REPORT=true